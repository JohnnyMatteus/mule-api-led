    <munit:test name="api-errors-maps-payment-declined" description="Pagamento recusado vira 422 PAYMENT_DECLINED">
        <munit:execution>
            <ee:transform doc:name="Transformação sob teste">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
import fromError from modules::ApiErrors
output application/json
---
fromError('ENROLLMENT:PAYMENT_DECLINED', 'Pagamento não aprovado', 'corr-test-0001')]]></ee:set-payload>
                </ee:message>
            </ee:transform>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::equalTo(readUrl('classpath://fixtures/api-errors/payment-declined-expected.json', 'application/json'))]" message="Saída difere do esperado em fixtures/api-errors/payment-declined-expected.json"/>
        </munit:validation>
    </munit:test>

    <munit:test name="api-errors-hides-integration-details" description="Erro de integração vira 500 sem detalhes internos">
        <munit:execution>
            <ee:transform doc:name="Transformação sob teste">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
import fromError from modules::ApiErrors
output application/json
---
fromError('ENROLLMENT:INTEGRATION_ERROR', 'Resposta inesperada da Studio System API', 'corr-test-0001')]]></ee:set-payload>
                </ee:message>
            </ee:transform>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::equalTo(readUrl('classpath://fixtures/api-errors/integration-error-expected.json', 'application/json'))]" message="Saída difere do esperado em fixtures/api-errors/integration-error-expected.json"/>
        </munit:validation>
    </munit:test>

    <munit:test name="api-errors-maps-each-upstream-to-503" description="Indisponibilidade de qualquer System API vira 503">
        <munit:execution>
            <ee:transform doc:name="Transformação sob teste">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
import fromError from modules::ApiErrors
output application/json
---
['STUDIO:UNAVAILABLE', 'PAYMENTS:UNAVAILABLE', 'MULE:RETRY_EXHAUSTED'] map fromError($, null, 'corr-test-0001').status]]></ee:set-payload>
                </ee:message>
            </ee:transform>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::equalTo([503, 503, 503])]"/>
        </munit:validation>
    </munit:test>
