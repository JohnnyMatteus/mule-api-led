                    <munit:variable key="charge" value="#[readUrl('classpath://fixtures/context/charge-approved.json', 'application/json')]"/>
                    <munit:variable key="businessDate" value="#['2026-11-21']"/>
                    <munit:variable key="requestedAt" value="#['2026-12-01T09:59:00Z']"/>
                </munit:variables>
            </munit:set-event>
        </munit:behavior>
        <munit:execution>
            <ee:transform doc:name="Transformação sob teste">
                <ee:message>
                    <ee:set-payload resource="dw/enrollment-eligibility.dwl"/>
