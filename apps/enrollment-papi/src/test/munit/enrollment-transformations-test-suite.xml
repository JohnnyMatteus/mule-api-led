                    <munit:variable key="businessDate" value="#['2026-11-21']"/>
                    <munit:variable key="requestedAt" value="#['2026-12-01T07:00:00-03:00']"/>
                </munit:variables>
            </munit:set-event>
        </munit:behavior>
        <munit:execution>
            <ee:transform doc:name="Transformação sob teste">
                <ee:message>
                    <ee:set-payload resource="dw/enrollment-eligibility.dwl"/>
