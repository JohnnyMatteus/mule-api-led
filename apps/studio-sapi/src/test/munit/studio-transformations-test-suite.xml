        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::equalTo(readUrl('classpath://fixtures/booking-to-reservation/expected-confirmed.json', 'application/json'))]" message="Saída difere do esperado em fixtures/booking-to-reservation/expected-confirmed.json"/>
        </munit:validation>
    </munit:test>

    <munit:test name="booking-to-reservation-fails-on-unknown-state" description="Estado fora do mapeamento falha em vez de violar o contrato" expectedErrorType="MULE:EXPRESSION">
        <munit:behavior>
            <munit:set-event doc:name="Payload fictício">
                <munit:payload value="#[readUrl('classpath://fixtures/booking-to-reservation/input-unknown-state.json', 'application/json')]" mediaType="application/json"/>
            </munit:set-event>
        </munit:behavior>
        <munit:execution>
            <ee:transform doc:name="Transformação sob teste">
                <ee:message>
                    <ee:set-payload resource="dw/booking-to-reservation.dwl"/>
                </ee:message>
            </ee:transform>
        </munit:execution>
    </munit:test>

    <munit:test name="api-errors-maps-business-error-with-details" description="Erro de negócio vira 404 com a descrição em details">
        <munit:execution>
            <ee:transform doc:name="Transformação sob teste">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
import fromError from modules::ApiErrors
output application/json
---
fromError('STUDIO:NOT_FOUND', 'Recurso não encontrado no SaaS de estúdios', 'corr-test-0001')]]></ee:set-payload>
                </ee:message>
            </ee:transform>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::equalTo(readUrl('classpath://fixtures/api-errors/not-found-expected.json', 'application/json'))]" message="Saída difere do esperado em fixtures/api-errors/not-found-expected.json"/>
        </munit:validation>
    </munit:test>

    <munit:test name="api-errors-hides-details-on-retry-exhausted" description="Retry esgotado vira 503 sem detalhes internos">
        <munit:execution>
            <ee:transform doc:name="Transformação sob teste">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
import fromError from modules::ApiErrors
output application/json
---
fromError('MULE:RETRY_EXHAUSTED', 'Connection refused: studio-saas', 'corr-test-0001')]]></ee:set-payload>
                </ee:message>
            </ee:transform>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::equalTo(readUrl('classpath://fixtures/api-errors/retry-exhausted-expected.json', 'application/json'))]" message="Saída difere do esperado em fixtures/api-errors/retry-exhausted-expected.json"/>
        </munit:validation>
    </munit:test>

    <munit:test name="api-errors-falls-back-to-500" description="Tipo de erro fora do catálogo vira 500 genérico">
        <munit:execution>
            <ee:transform doc:name="Transformação sob teste">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
import fromError from modules::ApiErrors
output application/json
---
fromError('JAVA:NULL_POINTER', 'stack interno', 'corr-test-0001')]]></ee:set-payload>
                </ee:message>
            </ee:transform>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::equalTo(readUrl('classpath://fixtures/api-errors/unexpected-expected.json', 'application/json'))]" message="Saída difere do esperado em fixtures/api-errors/unexpected-expected.json"/>
        </munit:validation>
    </munit:test>
</mule>
