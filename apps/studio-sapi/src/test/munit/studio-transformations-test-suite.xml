            </ee:transform>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::equalTo(readUrl('classpath://fixtures/booking-to-reservation/expected-held.json', 'application/json'))]" message="Saída difere do esperado em fixtures/booking-to-reservation/expected-held.json"/>
        </munit:validation>
    </munit:test>

    <munit:test name="booking-to-reservation-omits-null-expiration" description="Booking confirmado sem expiração não expõe expiresAt">
        <munit:behavior>
            <munit:set-event doc:name="Payload fictício">
                <munit:payload value="#[readUrl('classpath://fixtures/booking-to-reservation/input-confirmed.json', 'application/json')]" mediaType="application/json"/>
            </munit:set-event>
        </munit:behavior>
        <munit:execution>
            <ee:transform doc:name="Transformação sob teste">
                <ee:message>
                    <ee:set-payload resource="dw/booking-to-reservation.dwl"/>
